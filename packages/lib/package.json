{
  "name": "@rlyeh/lib",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:jamashita/rlyeh.git"
  },
  "license": "UNLICENSED",
  "author": "jamashita <jamashita@arachnid.xyz>",
  "type": "module",
  "exports": {
    "./Error": {
      "types": "./src/Error/index.ts",
      "import": {
        "development": "./src/Error/index.ts",
        "test": "./src/Error/index.ts",
        "default": "./dist/Error/index.js"
      }
    },
    "./Logger": {
      "types": "./src/Logger/index.ts",
      "import": {
        "development": "./src/Logger/index.ts",
        "test": "./src/Logger/index.ts",
        "default": "./dist/Logger/index.js"
      }
    },
    "./Type": {
      "types": "./src/Type/index.ts",
      "import": {
        "development": "./src/Type/index.ts",
        "test": "./src/Type/index.ts",
        "default": "./dist/Type/index.js"
      }
    }
  },
  "scripts": {
    "build": "bun clean && tsc",
    "check": "biome check --write --unsafe src/*",
    "clean": "rimraf dist",
    "format": "biome format --write src/*",
    "lint": "biome lint --write --unsafe src/*",
    "test": "vitest",
    "upd": "bun upd:upgrade && bun upd:install",
    "upd:install": "bun install && bun update && bun audit --fix",
    "upd:upgrade": "ncu --packageManager bun --deep --upgrade"
  },
  "dependencies": {
    "fp-ts": "2.16.11",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "uuid": "14.0.2",
    "zod": "4.6.5"
  },
  "engines": {
    "bun": ">=1.3.5"
  },
  "engineStrict": true
}
