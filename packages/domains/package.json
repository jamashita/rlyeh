{
  "name": "@rlyeh/domains",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:jamashita/rlyeh.git"
  },
  "license": "UNLICENSED",
  "author": "jamashita <jamashita@arachnid.xyz>",
  "type": "module",
  "exports": {
    "./Language": {
      "types": "./src/Language/index.ts",
      "import": {
        "development": "./src/Language/index.ts",
        "test": "./src/Language/index.ts",
        "default": "./dist/Language/index.js"
      }
    },
    "./Participant": {
      "types": "./src/Participant/index.ts",
      "import": {
        "development": "./src/Participant/index.ts",
        "test": "./src/Participant/index.ts",
        "default": "./dist/Participant/index.js"
      }
    },
    "./Stimulus": {
      "types": "./src/Stimulus/index.ts",
      "import": {
        "development": "./src/Stimulus/index.ts",
        "test": "./src/Stimulus/index.ts",
        "default": "./dist/Stimulus/index.js"
      }
    }
  },
  "scripts": {
    "build": "bun clean && tsc",
    "check": "biome check --write --unsafe src/*",
    "clean": "rimraf dist",
    "format": "biome format --write src/*",
    "lint": "biome lint --write --unsafe src/*",
    "test": "vitest",
    "upd": "bun upd:upgrade && bun upd:install",
    "upd:install": "bun install && bun update && bun audit --fix",
    "upd:upgrade": "ncu --packageManager bun --deep --upgrade"
  },
  "dependencies": {
    "@rlyeh/lib": "workspace:*",
    "fp-ts": "2.16.11",
    "zod": "4.6.5"
  },
  "engines": {
    "bun": ">=1.3.5"
  },
  "engineStrict": true
}
