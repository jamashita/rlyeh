{
  "name": "@rlyeh/frontend",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:jamashita/rlyeh.git"
  },
  "license": "UNLICENSED",
  "author": "tegebu <info@tegebu.com>",
  "type": "module",
  "scripts": {
    "build": "bun clean && vite build",
    "check": "biome check --write --unsafe src/*",
    "clean": "rimraf dist",
    "dev": "NODE_ENV=development vite --port 3000 --host 0.0.0.0",
    "format": "biome format --write src/*",
    "lint": "biome lint --write --unsafe src/*",
    "start": "node server.js",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "upd": "bun upd:upgrade && bun upd:install",
    "upd:install": "bun install && bun update && bun audit --fix",
    "upd:upgrade": "ncu --packageManager bun --deep --upgrade"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.3",
    "@rlyeh/applications": "workspace:*",
    "@rlyeh/domains": "workspace:*",
    "@rlyeh/lib": "workspace:*",
    "@tailwindcss/postcss": "4.3.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/router-plugin": "1.169.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fp-ts": "2.16.11",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.6.0",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-mcp": "10.6.6",
    "@storybook/addon-onboarding": "10.6.6",
    "@storybook/addon-styling-webpack": "3.0.2",
    "@storybook/tanstack-react": "10.6.6",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/devtools-vite": "0.8.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/browser": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "playwright": "1.65.0",
    "storybook": "10.6.6",
    "tailwindcss": "4.3.5",
    "tailwindcss-animate": "1.0.7",
    "vite": "8.3.6"
  },
  "engines": {
    "bun": ">=1.3.5"
  },
  "engineStrict": true
}
