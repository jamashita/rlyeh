{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "passThroughEnv": ["NODE_ENV"]
    },
    "check": {
      "cache": false,
      "dependsOn": [],
      "outputs": []
    },
    "clean": {
      "cache": false,
      "dependsOn": [],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "dependsOn": [],
      "outputs": [],
      "persistent": true,
      "passThroughEnv": ["NODE_ENV", "ADMIN_TOKEN"]
    },
    "format": {
      "cache": false,
      "dependsOn": [],
      "outputs": []
    },
    "lint": {
      "cache": false,
      "dependsOn": [],
      "outputs": []
    },
    "start": {
      "cache": false,
      "dependsOn": [],
      "outputs": [],
      "passThroughEnv": ["NODE_ENV", "ADMIN_TOKEN"]
    },
    "test": {
      "cache": false,
      "dependsOn": ["^test"],
      "outputs": []
    }
  }
}
