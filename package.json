{
  "name": "@jamashita/rlyeh",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:jamashita/rlyeh.git"
  },
  "license": "UNLICENSED",
  "author": "jamashita <jamashita@arachnid.xyz>",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "biome check --write .",
    "clean": "turbo run clean",
    "commit": "git cz",
    "dev": "turbo run dev",
    "examine": "turbo run test",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "prepare": "is-ci || husky",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "update": "bun update --latest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/bun": "1.3.12",
    "@types/node": "24.13.3",
    "git-cz": "4.9.0",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "lint-staged": "17.3.0",
    "rimraf": "6.1.3",
    "sort-package-json": "4.0.0",
    "turbo": "2.10.11",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.x"
  },
  "engineStrict": true,
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  }
}
