{
  "name": "@jamashita/rlyeh",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:jamashita/rlyeh.git"
  },
  "license": "UNLICENSED",
  "author": "jamashita <jamashita@arachnid.xyz>",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check --parallel",
    "clean": "turbo run clean --parallel",
    "commit": "git cz",
    "dev": "turbo run dev",
    "examine": "turbo run test",
    "format": "turbo run format --parallel",
    "lint": "turbo run lint --parallel",
    "prepare": "is-ci || husky",
    "start": "turbo run start",
    "upd": "bun upd:upgrade && bun upd:install",
    "upd:check": "ncu --packageManager bun --deep",
    "upd:install": "bun install && bun update && bun audit --fix",
    "upd:upgrade": "ncu --packageManager bun --deep --upgrade"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.3.5",
    "@types/node": "24.13.3",
    "git-cz": "4.9.0",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "jsdom": "30.0.1",
    "lint-staged": "17.5.1",
    "npm-check-updates": "23.1.0",
    "rimraf": "6.1.3",
    "sort-package-json": "4.0.0",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "packageManager": "bun@1.3.5",
  "engines": {
    "bun": ">=1.3.5"
  },
  "engineStrict": true
}
